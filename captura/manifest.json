{
  "manifestVersion": 5,
  "id": "com.trazo.captura",
  "name": "Trazo Captura",
  "version": "1.0.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "25.0.0",
    "data": { "apiVersion": 2, "loadEvent": "use" }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "capturaPanel",
      "label": { "default": "Trazo · Captura de trazos" },
      "minimumSize": { "width": 240, "height": 360 },
      "maximumSize": { "width": 1600, "height": 3000 },
      "preferredDockedSize": { "width": 300, "height": 680 },
      "preferredFloatingSize": { "width": 340, "height": 720 },
      "icons": [
        { "width": 23, "height": 23, "path": "icons/panel-dark.png", "scale": [1, 2], "theme": ["darkest", "dark", "medium"] },
        { "width": 23, "height": 23, "path": "icons/panel-light.png", "scale": [1, 2], "theme": ["lightest", "light"] }
      ]
    }
  ],
  "icons": [
    { "width": 48, "height": 48, "path": "icons/plugin.png", "scale": [1, 2], "theme": ["all"], "species": ["pluginList"] }
  ],
  "requiredPermissions": {
    "localFileSystem": "request"
  }
}
